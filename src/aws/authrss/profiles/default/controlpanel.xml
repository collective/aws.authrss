<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        name="portal_controlpanel"
        i18n:domain="aws.authrss"
>
  <configlet action_id="auth-rss"
             appId="aws.authrss"
             category="Products"
             condition_expr=""
             icon_expr="string:$portal_url/rss.png"
             title="Authenticated RSS"
             url_expr="string:${portal_url}/@@rss-token-controlpanel"
             visible="True"
             i18n:attributes="title"
  >
    <permission>Plone Site Setup: RSS authentication tokens</permission>
  </configlet>
</object>
