<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        name="portal_actions"
>
  <object name="document_actions">
    <object meta_type="CMF Action"
            name="rss"
            i18n:domain="plone"
    >
      <property name="title"
                i18n:translate=""
      >RSS feed</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">object/@@auth-rss-link</property>
      <property name="link_target" />
      <property name="icon_expr">string:rss</property>
      <property name="available_expr">object/@@syndication-util/context_enabled</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object name="user">
    <object insert-before="logout"
            meta_type="CMF Action"
            name="rss_token"
            i18n:domain="aws.authrss"
    >
      <property name="title"
                i18n:translate=""
      >RSS Token</property>
      <property name="description"
                i18n:translate=""
      >View or reset your RSS token</property>
      <property name="url_expr">string:${globals_view/navigationRootUrl}/@@personal-rss-token</property>
      <property name="link_target" />
      <property name="icon_expr">string:rss</property>
      <property name="available_expr">python:member is not None</property>
      <property name="permissions">
        <element value="View" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
</object>
